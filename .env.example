# Required: Supabase project and database credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres.your-project-id:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Server (optional; defaults shown)
PORT=3000
JSON_BODY_LIMIT=1mb
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Supabase storage (optional; defaults shown)
SUPABASE_PROFILE_IMAGES_BUCKET=profile-images
SUPABASE_XRAY_BUCKET=xray-images
SUPABASE_XRAY_SIGNED_URL_EXPIRES_IN=14400
SUPABASE_XRAY_MAX_FILE_SIZE_BYTES=10485760
SUPABASE_XRAY_MAX_PIXELS=50000000
SUPABASE_PROFILE_IMAGE_SIGNED_URL_EXPIRES_IN=604800

# Export worker limits (optional; defaults shown)
EXPORT_MAX_CONCURRENCY=2
EXPORT_MAX_QUEUE=10
EXPORT_TIMEOUT_MS=60000
# Source/preview requests are isolated so final downloads cannot block the editor.
EXPORT_SOURCE_MAX_CONCURRENCY=4
EXPORT_SOURCE_MAX_QUEUE=20
EXPORT_SOURCE_TIMEOUT_MS=30000
EXPORT_MAX_PAGES=6
EXPORT_MAX_ASSETS=30
EXPORT_ASSET_CONCURRENCY=3
EXPORT_ASSET_CACHE_TTL_MS=300000
EXPORT_ASSET_CACHE_MAX_BYTES=134217728
EXPORT_MAX_SOURCE_BYTES=157286400

# Shared frontend print renderer (optional)
# Leave unset to use the legacy backend report renderer during migration.
# The URL must not contain credentials, a query string, or a fragment.
# EXPORT_RENDERER_URL=http://localhost:5173/export/render
EXPORT_RENDERER_READY_TIMEOUT_MS=15000
EXPORT_RENDER_CACHE_TTL_MS=30000
EXPORT_RENDER_CACHE_MAX_BYTES=67108864
